# Ollama model with TOOL CALLING support.
OLLAMA_MODEL=qwen3:8b

# Context window (tokens). Ollama's default is too small for agents.
OLLAMA_NUM_CTX=16384
OLLAMA_DISABLE_THINKING=true

# Where databases, charts and reports are written
DATAPILOT_DATA_DIR=data

# Metrics catalog MCP server (HTTP)
METRICS_HOST=127.0.0.1
METRICS_PORT=8765